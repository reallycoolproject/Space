# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/space

# JWT secret key for token authentication (min 32 chars)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5176

# LiveKit WebRTC Credentials (for Voice/Video Calls)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# Admin Account Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# Port and Client Origin
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,https://localhost:5174
