{
  "framework": "vite",
  "installCommand": "npm --prefix homepage install",
  "buildCommand": "npm --prefix homepage run build",
  "outputDirectory": "homepage/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://volunteers-rendered-constructed-mar.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://volunteers-rendered-constructed-mar.trycloudflare.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
